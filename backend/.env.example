# Copie para .env e ajuste os valores locais. Nunca versione o .env.
# Gere uma chave com pelo menos 32 bytes:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-com-32-bytes-ou-mais
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Banco: PostgreSQL/PostGIS do docker-compose
DATABASE_URL=postgres://meubuzu:meubuzu@127.0.0.1:5432/meubuzu

# Redis (cache e rate limit). Sem REDIS_URL, usa cache em memória.
REDIS_URL=redis://127.0.0.1:6379/0

# TTL do catálogo em cache (segundos). A importação invalida o cache da cidade.
CATALOG_CACHE_TTL_SECONDS=300

# Rastreamento (somente demonstração por enquanto).
# NUNCA use TRACKING_DEMO_ACCESS_ENABLED=true em produção.
TRACKING_POSITIONS_SOURCE=csv_demo
# Opcional; omita para usar backend/apps/tracking/data/locations
# TRACKING_CSV_DIR=/caminho/para/backend/apps/tracking/data/locations
TRACKING_DEMO_ACCESS_ENABLED=true
TRACKING_POSITION_WINDOW_SECONDS=300
TRACKING_STALE_AFTER_SECONDS=120
# Corte rígido das posições live devolvidas pelo endpoint (5 min).
TRACKING_LIVE_MAX_POSITION_AGE_SECONDS=300
TRACKING_CACHE_TTL_SECONDS=10

# Rastreamento de fontes live (São Paulo) sem billing. SOMENTE STAGING.
# Em produção o acesso depende de trial/assinatura.
TRACKING_LIVE_ACCESS_ENABLED=false
# Lock do crawl, em segundos (menor que o intervalo de 30 s).
TRACKING_CRAWL_LOCK_SECONDS=25

# Histórico de posições: 24 h, partição diária e trim horário.
TRACKING_HISTORY_ENABLED=true
TRACKING_HISTORY_RETENTION_HOURS=24
TRACKING_HISTORY_PARTITION_UNIT=day
TRACKING_HISTORY_TRIM_MINUTES=60
TRACKING_HISTORY_TRIM_BATCH=50000
TRACKING_HISTORY_MAX_CAPTURE_AGE_SECONDS=600

# API Olho Vivo (SPTrans). NUNCA versione o token.
SPTRANS_API_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1
SPTRANS_API_TOKEN=
SPTRANS_API_TIMEOUT_SECONDS=30
SPTRANS_API_REQUESTS_PER_SECOND=5
SPTRANS_API_MAX_RETRIES=3
# Arquivos do GTFS (não versionados). Baixe manualmente no portal da SPTrans.
SPTRANS_GTFS_DIR=./data/gtfs/sptrans

# Celery: broker separado do cache. Use CELERY_TASK_ALWAYS_EAGER=true nos testes.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# E-mail: console imprime o código no terminal.
# Para usar o Mailpit do docker-compose, troque para SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=MeuBuzu <nao-responda@meubuzu.local>

# Código de acesso
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_EMAIL=5
OTP_RATE_LIMIT_PER_IP=20
# Só ative atrás de um proxy/load balancer confiável.
TRUST_X_FORWARDED_FOR=false

# Tokens
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
