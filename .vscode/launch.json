{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Inicia o emulador Android (se necessário) e roda o app em `app/`.
            // O `cwd` é relativo à raiz do workspace.
            "name": "app (Android emulator)",
            "cwd": "app",
            "program": "lib/main.dart",
            "toolArgs": ["--dart-define-from-file=.env"],
            "emulatorId": "Medium_Phone_API_37.0",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "app",
            "cwd": "app",
            "program": "lib/main.dart",
            "toolArgs": ["--dart-define-from-file=.env"],
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "app (profile mode)",
            "cwd": "app",
            "program": "lib/main.dart",
            "toolArgs": ["--dart-define-from-file=.env"],
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "app (release mode)",
            "cwd": "app",
            "program": "lib/main.dart",
            "toolArgs": ["--dart-define-from-file=.env"],
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            // Sobe a API Django com o interpretador do backend/.venv.
            // Play (F5) inicia; Shift+F5 ou o quadrado vermelho param.
            // `--noreload` evita conflito entre o debugger e o autoreload.
            "name": "backend (Django)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/manage.py",
            "args": ["runserver", "0.0.0.0:8000", "--noreload"],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/bin/python",
            "django": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}
