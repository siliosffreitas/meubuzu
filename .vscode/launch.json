    "version": "0.2.0",
    "configurations": [
        {
            // Inicia o emulador Android (se necessário) e roda o app em `app/`.
            // O `cwd` é relativo à raiz do workspace.
            "name": "app (Android emulator)",
            "cwd": "app",
            "program": "lib/main.dart",
            "emulatorId": "Medium_Phone_API_37.0",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "app",
            "cwd": "app",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "app (profile mode)",
            "cwd": "app",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "app (release mode)",
            "cwd": "app",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "backend",
            "cwd": "backend",
            "request": "launch",
            "type": "dart"
        }
    ]
}
